<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.uniquindio.controlador.MatriculaControlador">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Registro de Matrícula - LinguaPlus" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
    <TextField fx:id="txtNombre" promptText="Nombre del Estudiante"/>
    <TextField fx:id="txtTelefono" promptText="Teléfono (Para probar nro perfecto)"/>
    <TextField fx:id="txtDescuento" promptText="Descuento (Ej. 15)"/>
    <Button text="Registrar Matrícula" onAction="#registrarMatriculaAction"/>
</VBox>